{
  "name": "clss-config-tool",
  "productName": "CLSS Configuration Tool",
  "description": "Configuration tool for Inspire panels",
  "version": "1.0.0",
  "license": "",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --aot",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test-ci": "ng test --watch=false --reporters junit,verbose --code-coverage --browsers HeadlessChrome --progress=false",
    "coverage": "ng test --watch=false --code-coverage",
    "lint": "ng lint",
    "lint:ci": "ng lint honeywell.fts.frontend --force true --format json > LintReport.json  && ng lint battery-calculator --force true --format json > LintBatCalc.json",
    "lint:junit": "ng lint --force true --format junit > LintErrors.xml",
    "lint:checkstyle": "ng lint honeywell.fts.frontend --force true --format checkstyle > LintErrors.xml && ng lint battery-calculator --force true --format checkstyle > LintBatCalc.xml && ng lint manage-vouchers --force true --format checkstyle > LintMngVouchers.xml",
    "bundle-report": "webpack-bundle-analyzer dist/stats.json",
    "electron-dev": "concurrently -k \"ng serve\" \"electron .\"",
    "electron-mac": "ng build --configuration production --base-href=\"./\" && ng build --project=manage-vouchers --configuration production --base-href=\"./\" && electron-builder build --mac",
    "electron-windows": "ng build --configuration production --preserve-symlinks --base-href=\"./\"  --configuration production --preserve-symlinks --base-href=\"./\" && electron-builder build --windows --ia32",
    "electron-windev": "ng build --aot --base-href=\"./\" && electron-builder build --windows --ia32",
    "electron-linux": "ng build --configuration production --base-href=\"./\" && ng build --project=manage-vouchers --configuration production --base-href=\"./\" && electron-builder build --linux",
    "battery-calculator": "ng serve --project=battery-calculator",
    "battery-calculator:lint": "ng lint battery-calculator --fix",
    "battery-calculator:build": "ng build --project=battery-calculator --aot",
    "battery-calculator:build:prod": "ng build --project=battery-calculator --configuration production",
    "battery-calculator:test": "ng test battery-calculator",
    "manage-vouchers": "ng serve --project=manage-vouchers",
    "manage-vouchers:lint": "ng lint manage-vouchers --fix",
    "manage-vouchers:build": "ng build --project=manage-vouchers --aot",
    "manage-vouchers:build:prod": "ng build --project=manage-vouchers --configuration production",
    "manage-vouchers:test": "ng test manage-vouchers",
    "start:electron": "electron ."
  },
  "private": true,
  "author": "Honeywell",
  "dependencies": {
    "@angular-eslint/schematics": "^1.0.0",
    "@angular/animations": "^18.2.7",
    "@angular/cdk": "^18.2.7",
    "@angular/common": "^18.2.7",
    "@angular/compiler": "^18.2.7",
    "@angular/core": "^18.2.7",
    "@angular/forms": "^18.2.7",
    "@angular/material": "^18.2.7",
    "@angular/platform-browser": "^18.2.7",
    "@angular/platform-browser-dynamic": "^18.2.7",
    "@angular/router": "^18.2.7",
    "@electron/remote": "^2.0.8",
    "@microsoft/signalr": "^5.0.17",
    "@ngrx/effects": "^18.1.0",
    "@ngrx/entity": "^18.1.0",
    "@ngrx/router-store": "^18.1.0",
    "@ngrx/store": "^18.1.0",
    "@ngrx/store-devtools": "^18.1.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@types/file-saver": "^2.0.5",
    "ag-grid-angular": "^33.0.3",
    "ag-grid-community": "^33.0.3",
    "angular-auth-oidc-client": "^18.0.1",
    "bootstrap": "^4.4.1",
    "bootstrap-sass": "^3.4.1",
    "chart.js": "^4.4.4",
    "core-js": "^3.16.2",
    "exceljs": "^4.3.0",
    "file-saver": "^2.0.2",
    "istanbul-api": "^3.0.0",
    "istanbul-reports": "^3.0.2",
    "jasmine-marbles": "^0.8.1",
    "jquery": "^3.4.1",
    "jquery-validation": "^1.19.3",
    "js-yaml": "^3.13.1",
    "kill-port": "^1.6.1",
    "lodash": "^4.17.21",
    "material-design-icons-iconfont": "^6.7.0",
    "ng2-charts": "^5.0.4",
    "ng2-pdf-viewer": "^10.0.0",
    "ngx-bootstrap": "^5.6.2",
    "ngx-image-cropper": "^8.0.0",
    "ngx-toastr": "^16.2.0",
    "rxjs": "^6.6.7",
    "sass": "^1.57.1",
    "tslib": "^2.4.1",
    "zone.js": "^0.14.10",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.7",
    "@angular-devkit/core": "^18.2.7",
    "@angular-devkit/schematics": "18.2.7",
    "@angular/cli": "^18.2.7",
    "@angular/compiler-cli": "^18.2.7",
    "@angular/language-service": "^18.2.7",
    "@ngrx/schematics": "^17.2.0",
    "@types/bootstrap": "^3.4.0",
    "@types/fs-extra": "^8.1.1",
    "@types/jasmine": "^3.5.14",
    "@types/jasminewd2": "^2.0.8",
    "@types/jquery": "3.5.0",
    "@types/lodash": "^4.14.161",
    "@types/node": "14.17.9",
    "browserslist": "^4.16.6",
    "codelyzer": "^6.0.1",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "jasmine-core": "^3.7.1",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.1.0",
    "karma-cli": "^2.0.0",
    "karma-coverage": "^2.2.1",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-html-reporter": "^0.2.7",
    "karma-jasmine": "^4.0.1",
    "karma-jasmine-html-reporter": "^1.6.0",
    "karma-junit-reporter": "^2.0.1",
    "karma-verbose-reporter": "^0.0.6",
    "karma-webpack": "^5.0.1",
    "protractor": "^7.0.0",
    "puppeteer": "^10.2.0",
    "ts-loader": "^9.5.2",
    "ts-node": "~8.10.1",
    "tslint": "^6.1.3",
    "typescript": "~5.4.5",
    "webpack-bundle-analyzer": "^3.9.0"
  },
  "build": {
    "appId": "com.honeywell.clss-configuration-tool",
    "buildVersion": "1.0.0.0",
    "launchUiVersion": "1.0.0.0",
    "directories": {
      "buildResources": "./src/assets",
      "output": "./dist"
    },
    "extraResources": [
      {
        "from": "../Honeywell.FTS.WebAPI.Server/bin/Release/net6.0/",
        "to": "Honeywell.FTS.WebAPI.Server/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../CLSS/Honeywell.CLSSCTS.WebAPI.Server/bin/Release/netcoreapp3.1/publish/",
        "to": "Honeywell.CLSSCTS.WebAPI.Server/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Honeywell.FTS.Frontend/src/assets/i18n/",
        "to": "Honeywell.FTS.WebAPI.Server/ReportingAssets/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Honeywell.FTS.DocumentGeneration/Images/",
        "to": "Honeywell.FTS.WebAPI.Server/ReportingAssets/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Honeywell.FTS.DocumentGeneration/DocxGeneration/DocxTemplateFiles/",
        "to": "Honeywell.FTS.WebAPI.Server/ReportingAssets/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Honeywell.FTS.DocumentGeneration/ConfigReportData_Schema.json",
        "to": "Honeywell.FTS.WebAPI.Server/ReportingAssets/ConfigReportData_Schema.json"
      }
    ],
    "mac": {
      "category": "cross-platform-desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ]
    },
    "icon": "build/assets/images/HoneywellLogo.png",
    "files": [
      "main.js",
      "build",
      "licensingbuild"
    ],
    "extraFiles": [
      {
        "from": "../Honeywell.FTS.WebAPI.Server/bin/Release/net6.0/",
        "filter": [
          "appsettings.json",
          "Log4Net.config"
        ]
      }
    ]
  }
}
